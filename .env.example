# ── Server ────────────────────────────────────────────────────
PORT=3000
# Set to production when deployed (SHORT_DOMAIN becomes mandatory)
NODE_ENV=production
# Number of reverse proxies in front of the app (1 for nginx/Caddy), so rate
# limits see real client IPs. Leave empty when exposed directly.
TRUST_PROXY=

# ── Database (MySQL / MariaDB) ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=shorturl

# ── Public domain (used in API responses) ─────────────────────
# The domain your short links are served from, no trailing slash.
SHORT_DOMAIN=https://go.example.com

# ── Protection for creating links ─────────────────────────────
# If set (16+ chars), POST /shorten needs the header  x-api-key: <value>
# or  Authorization: Bearer <value>.  Generate one: openssl rand -hex 24
# NOTE: the built-in web form does not send a key; see README.
API_KEY=

# ── Rate limits (requests per minute per IP) ──────────────────
RATE_LIMIT_CREATE_PER_MIN=20
RATE_LIMIT_UNLOCK_PER_MIN=10
